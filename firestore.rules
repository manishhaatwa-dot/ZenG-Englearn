rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {


    // =====================================================
    // HELPER FUNCTIONS
    // =====================================================

    function signedIn() {

      return request.auth != null;

    }


    function isOwner(uid) {

      return signedIn()
        && request.auth.uid == uid;

    }


    // =====================================================
    // ZENG USER PROFILES
    // =====================================================

    match /zeng_englearn_users/{uid} {


      // ---------------------------------------------------
      // READ
      // ---------------------------------------------------
      //
      // Logged-in users can read user profiles.
      //
      // Later the block system will add the appropriate
      // privacy restrictions for blocked users.
      //

      allow read:
        if signedIn();


      // ---------------------------------------------------
      // CREATE
      // ---------------------------------------------------
      //
      // Only the authenticated user can create their own
      // profile.
      //

      allow create:
        if isOwner(uid)

        // Firebase UID must match document ID.
        && request.resource.data.uid == uid

        // Display name is mandatory.
        && request.resource.data.displayName is string

        && request.resource.data.displayName.size() >= 2

        && request.resource.data.displayName.size() <= 30

        // Initial name-change count.
        && request.resource.data.nameChangeCount == 0

        // New accounts start active.
        && request.resource.data.accountStatus == "active";


      // ---------------------------------------------------
      // UPDATE
      // ---------------------------------------------------

      allow update:
        if isOwner(uid)

        // -------------------------------------------------
        // UID cannot change.
        // -------------------------------------------------

        && request.resource.data.uid
           == resource.data.uid


        // -------------------------------------------------
        // Original creation time cannot change.
        // -------------------------------------------------

        && request.resource.data.createdAt
           == resource.data.createdAt


        // -------------------------------------------------
        // Name-change count can only increase.
        // -------------------------------------------------

        && request.resource.data.nameChangeCount
           >= resource.data.nameChangeCount


        // -------------------------------------------------
        // Maximum three name changes.
        // -------------------------------------------------

        && request.resource.data.nameChangeCount
           <= 3


        // -------------------------------------------------
        // A normal client update can increase the count
        // by only one.
        // -------------------------------------------------

        && request.resource.data.nameChangeCount
           <= resource.data.nameChangeCount + 1


        // -------------------------------------------------
        // Display name remains valid.
        // -------------------------------------------------

        && request.resource.data.displayName is string

        && request.resource.data.displayName.size() >= 2

        && request.resource.data.displayName.size() <= 30


        // -------------------------------------------------
        // Display name lowercase value must match the
        // display name.
        // -------------------------------------------------

        && request.resource.data.displayNameLower
           == request.resource.data.displayName
                .lower()


        // -------------------------------------------------
        // Account status can only be one of the supported
        // values.
        // -------------------------------------------------

        && request.resource.data.accountStatus
           in [
             "active",
             "deactivated"
           ];


      // ---------------------------------------------------
      // DELETE
      // ---------------------------------------------------
      //
      // Direct client-side deletion is disabled.
      // Complete account deletion will use a controlled
      // deletion flow so related data can also be removed.
      //

      allow delete:
        if false;

    }


    // =====================================================
    // ALL OTHER COLLECTIONS
    // =====================================================
    //
    // Future collections such as chats, messages, blocks,
    // notification tokens and learning data will receive
    // their own security rules when implemented.
    //

    match /{document=**} {

      allow read, write:
        if false;

    }

  }

}
